	"name": "WHODAS12",
	"title": "World Health Organization Disability Assessment Schedule (12 item version)",
	"description": "Abbreviated 12-item version of WHODAS 2.0 to assess functioning and disability",
	"purpose": "A 12-item questionnaire developed by the WHO to assess health and disability across six domains: cognition, mobility, self-care, getting along, life activities, and participation. It provides a comprehensive measure of functioning and disability. Simple scoring: the scores assigned to each of the items – none (0), mild (1) moderate (2), severe (3) and extreme (4) – are summed.",
	"version": "1.0.0",
	"status": "active",
	"date": "2025-01-01T00:00:00+00:00",
	"subjectType": [
		"Patient"
	],
	"publisher": "K-HEALTHinAIR",
