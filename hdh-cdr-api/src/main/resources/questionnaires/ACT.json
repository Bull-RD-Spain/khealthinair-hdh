	"name": "ACT",
	"title": "Asthma Control Test (ACT)",
	"description": "Asthma Control Test (ACT) is a simple, patient-completed questionnaire used to assess asthma control.",
	"purpose": "A 5-item self-administered questionnaire designed to assess asthma control in individuals aged 12 and older. It evaluates symptoms, medication use, and overall asthma control over the past 4 weeks. Scores range from 5 to 25, with higher scores indicating better control. A score below 20 suggests inadequate asthma control",
	"version": "1.0.0",
	"status": "active",
	"date": "2025-01-01T00:00:00+00:00",
