	<!-- <pattern> -->
	<!-- <![CDATA[%d{dd/MM/yyyy HH:mm:ss.SSS} %-5level hdh-cdr-api %logger{36} -
		%msg%n]]> -->
	<!-- </pattern> -->
	<!-- </encoder> -->
