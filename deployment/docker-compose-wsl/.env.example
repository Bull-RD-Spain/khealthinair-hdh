# =============================================================================
# K-HEALTHinAIR HDH Module (CDR) - Local Environment Variables (EXAMPLE)
# =============================================================================
# Copy this file to '.env' and replace every CHANGE_ME placeholder.
# NEVER commit the resulting '.env' file. Values shown here are placeholders.
# =============================================================================

# -----------------------------------------------------------------------------
# Image versions
# -----------------------------------------------------------------------------
HDH_CDR_VERSION=7.6.0
HDH_CDR_API_VERSION=1.0.0

# -----------------------------------------------------------------------------
# hdh-cdr-db (PostgreSQL 17.0)
# -----------------------------------------------------------------------------
ALLOW_EMPTY_PASSWORD=false
POSTGRES_USER=CHANGE_ME_DB_USER
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=CHANGE_ME_DB_NAME

# -----------------------------------------------------------------------------
# hdh-cdr (HAPI FHIR Server)
# -----------------------------------------------------------------------------
CDR_LOGGING_MODE=dev
DATASOURCE_URL=jdbc:postgresql://hdh-cdr-db:5432/CHANGE_ME_DB_NAME?ssl=false&TimeZone=UTC
SERVER_SERVLET_CONTEXT_PATH=/hdh-cdr/
CDR_HAPI_FHIR_SERVER_ADDRESS=http://localhost:8090/hdh-cdr

# -----------------------------------------------------------------------------
# hdh-cdr-api (optional, only with --profile hdh-api)
# -----------------------------------------------------------------------------
CDR_API_CONTEXTPATH=/hdh-cdr-api
APIKEY_ADMIN=CHANGE_ME_ADMIN_KEY
APIKEY_PILOT=CHANGE_ME_PILOT_KEY
