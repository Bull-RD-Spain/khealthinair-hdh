# https://docs.docker.com/compose/env-file/ (copy to '.env' or pass via --env-file)
# e.g.: cp khealthinair-hdh-cdr.env.example .env && podman compose up -d
#       docker-compose --env-file khealthinair-hdh-cdr.env.example up
# Replace every CHANGE_ME placeholder. NEVER commit the resulting file.

HDH_CDR_VERSION=7.6.0
HDH_CDR_API_VERSION=1.0.0

####### HDH-CDR-DB + HDH-CDR + HDH-CDR-API #######
ALLOW_EMPTY_PASSWORD=false
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_USER=CHANGE_ME_DB_USER
POSTGRES_DB=CHANGE_ME_DB_NAME
CDR_LOGGING_MODE=dev
DATASOURCE_URL=jdbc:postgresql://hdh-cdr-db:5432/CHANGE_ME_DB_NAME?ssl=false&TimeZone=UTC
SERVER_SERVLET_CONTEXT_PATH=/hdh-cdr/
CDR_HAPI_FHIR_SERVER_ADDRESS=http://localhost:8080/hdh-cdr
CDR_API_CONTEXTPATH=/hdh-cdr-api
APIKEY_ADMIN=CHANGE_ME_ADMIN_KEY
APIKEY_PILOT=CHANGE_ME_PILOT_KEY
